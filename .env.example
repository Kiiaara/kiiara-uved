# === Telegram ===
# Токен ТВОЕГО нового бота от @BotFather
TELEGRAM_BOT_TOKEN=
# chat_id твоего канала (бот должен быть там админом). Формат -100...
TELEGRAM_CHAT_IDS=

# === Twitch ===
# ТВОЁ приложение с https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Твой твич-ник (логин канала, латиницей, как в ссылке twitch.tv/XXX)
TWITCH_LOGIN=

# === Настройки ===
POLL_INTERVAL=60
# Задержка перед постом ради свежего кадра превью, сек (твич обновляет кадр ~раз в 5 мин)
PREVIEW_DELAY=150
LOG_LEVEL=INFO
